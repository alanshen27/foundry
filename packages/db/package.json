{
  "name": "@foundry/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "push": "dotenv -e ../../.env.local -e ../../.env -- prisma db push",
    "migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env.local -e ../../.env -- tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "migrate:deploy": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate status",
    "migrate:check": "dotenv -e ../../.env.local -e ../../.env -- sh -c 'prisma migrate diff --from-url \"$DIRECT_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code'",
    "rls:check": "dotenv -e ../../.env.local -e ../../.env -- tsx src/check-rls.ts"
  },
  "dependencies": {
    "@foundry/domain": "workspace:*",
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
