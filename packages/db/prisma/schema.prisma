generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer) connection used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct/session connection used for migrations & `db push` (DDL cannot run
  // over the transaction pooler). Falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  // Supabase auth.users.id when AUTH_MODE=supabase; null for LOCAL users.
  supabaseId   String?  @unique
  email        String   @unique
  name         String
  // Profile picture (Supabase user_metadata.avatar_url / OAuth picture).
  avatarUrl    String?
  // Only set for the LOCAL dev/e2e auth adapter (scrypt hash). Never used
  // when AUTH_MODE=supabase.
  localPasswordHash String?
  createdAt    DateTime @default(now())

  memberships       WorkspaceMembership[]
  createdWorkspaces Workspace[]           @relation("WorkspaceCreator")
  invitationsSent   Invitation[]          @relation("InvitationInviter")
  auditEvents       AuditEvent[]
}

// ---------- Workspace ----------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User                  @relation("WorkspaceCreator", fields: [createdById], references: [id])
  memberships WorkspaceMembership[]
  projects    Project[]
  folders     ProjectFolder[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  sites       Site[]
}

/// Nested folder for organizing projects inside a workspace sidebar tree.
model ProjectFolder {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  /// Palette id from apps/web/lib/folder-color.ts. Null = derive from the folder id.
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    ProjectFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[] @relation("FolderTree")
  projects  Project[]

  @@index([workspaceId, parentId])
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants    CapabilityGrant[]

  @@unique([workspaceId, userId])
}

// Extends a membership beyond its role defaults (PRD 7.2). Grants never
// reduce role defaults.
model CapabilityGrant {
  id           String   @id @default(cuid())
  membershipId String
  capability   String
  // Null = workspace-wide; otherwise scoped to a project.
  projectId    String?
  grantedById  String
  createdAt    DateTime @default(now())

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, capability, projectId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  /// Optional project context when the invite was sent from a project page.
  /// Membership is always workspace-scoped; this only affects accept redirect
  /// and optional guest project.read grant.
  projectId   String?
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([workspaceId, email])
}

// ---------- Project ----------

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id             String        @id @default(cuid())
  workspaceId    String
  folderId       String?
  name           String
  slug           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  activeBranchId String?
  createdById    String
  createdAt      DateTime      @default(now())
  /// Storage key for the cached 3D preview shown on workspace cards.
  thumbnailKey       String?
  /// Compared against the MODEL3D doc's updatedAt to detect a stale preview.
  thumbnailUpdatedAt DateTime?

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder           ProjectFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  invitations      Invitation[]
  branches         ProjectBranch[]
  stageStates      StageState[]
  artifacts        Artifact[]
  briefs           ProjectBrief[]
  requirements     Requirement[]
  components       Component[]
  repoLinks        RepoLink[]
  validationChecks ValidationCheck[]
  releases         Release[]
  designDocs       DesignDoc[]
  chatMessages         ChatMessage[]
  chatChannels         ChatChannel[]
  chatChannelCategories ChatChannelCategory[]
  chatRuns             ChatRun[]
  codeFiles            CodeFile[]
  sites                Site[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, folderId])
}

model ProjectBranch {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  isDefault   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageStates StageState[]
  artifacts   Artifact[]

  @@unique([projectId, name])
}

enum Stage {
  IDEATE
  ENGINEER
  VERIFY
  LAUNCH
}

enum StageStatus {
  NOT_STARTED
  DRAFT
  RUNNING
  NEEDS_REVIEW
  APPROVED
  BLOCKED
  STALE
}

model StageState {
  id                 String      @id @default(cuid())
  projectId          String
  branchId           String
  stage              Stage
  status             StageStatus @default(NOT_STARTED)
  approvedSnapshotId String?
  approvedById       String?
  approvedAt         DateTime?
  updatedAt          DateTime    @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  ProjectBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([projectId, branchId, stage])
}

// ---------- Artifacts (metadata only in Phase 0) ----------

enum VerificationState {
  UNVERIFIED
  SIMULATED
  VERIFIED
  REJECTED
}

model Artifact {
  id                String            @id @default(cuid())
  projectId         String
  branchId          String
  kind              String
  name              String
  storageKey        String
  sha256            String?
  mimeType          String
  sizeBytes         Int?
  verificationState VerificationState @default(UNVERIFIED)
  createdById       String
  createdAt         DateTime          @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  ProjectBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

// ---------- Audit / domain events ----------

model AuditEvent {
  id            String   @id @default(cuid())
  type          String
  schemaVersion Int      @default(1)
  workspaceId   String
  projectId     String?
  branchId      String?
  actorId       String
  actorType     String   @default("USER")
  causationId   String?
  correlationId String?
  payload       Json
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

// ---------- Stage 1: Ideate ----------

model ProjectBrief {
  id                  String   @id @default(cuid())
  projectId           String
  branchId            String
  prompt              String?
  intendedUse         String?
  environment         String?
  targetAudience      String?
  budgetCents         Int?
  currency            String   @default("USD")
  dimensions          String?
  performanceTargets  String?
  manufacturingNotes  String?
  updatedById         String
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, branchId])
}

enum RequirementType {
  FUNCTIONAL
  ELECTRICAL
  MECHANICAL
  SOFTWARE
  VISUAL
  MANUFACTURING
  COST
  COMPLIANCE
  UX
}

enum RequirementPriority {
  MUST
  SHOULD
  MAY
}

enum RequirementStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

model Requirement {
  id                 String              @id @default(cuid())
  projectId          String
  branchId           String
  title              String
  description        String?
  type               RequirementType     @default(FUNCTIONAL)
  priority           RequirementPriority @default(SHOULD)
  status             RequirementStatus   @default(PROPOSED)
  minValue           Float?
  maxValue           Float?
  unit               String?
  rationale          String?
  verificationMethod String?
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, branchId])
}

// ---------- Stage 2: Engineer ----------

enum Discipline {
  ELECTRONICS
  MECHANICAL
  SOFTWARE
  DESIGN
}

enum DesignDocKind {
  CIRCUIT
  PCB
  MODEL3D
  DESIGN
}

/**
 * JSON documents backing the visual editors: circuit schematic (CIRCUIT),
 * PCB board layout (PCB), parametric 3D model (MODEL3D), and industrial
 * design notes (DESIGN). One doc per kind per branch; edits autosave
 * last-write-wins. Live co-editing (Yjs) replaces this storage in a later phase.
 */
model DesignDoc {
  id          String        @id @default(cuid())
  projectId   String
  branchId    String
  kind        DesignDocKind
  data        Json
  updatedById String
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, branchId, kind])
}

model Component {
  id            String     @id @default(cuid())
  projectId     String
  branchId      String
  discipline    Discipline @default(ELECTRONICS)
  refDes        String?
  name          String
  manufacturer  String?
  partNumber    String?
  quantity      Int        @default(1)
  unitCostCents Int?
  sourceUrl     String?
  imageUrl      String?
  notes         String?
  createdById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, branchId])
}

model RepoLink {
  id          String   @id @default(cuid())
  projectId   String
  branchId    String
  role        String
  url         String
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   CodeFile[]

  @@index([projectId, branchId])
}

/**
 * Files in the project code workspace (Engineer > Code). Each file belongs
 * to a linked repository and is edited in-app (Monaco). Push/pull sync with
 * the actual GitHub repo arrives with the GitHub App integration phase.
 */
model CodeFile {
  id          String   @id @default(cuid())
  projectId   String
  branchId    String
  repoId      String
  path        String
  content     String   @default("")
  updatedById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    RepoLink @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, path])
  @@index([projectId, branchId])
}

// ---------- AI copilot ----------

/**
 * Discord-style category grouping channels on a project branch
 * (e.g. "Text Channels", "Hardware", "Firmware").
 */
model ChatChannelCategory {
  id        String   @id @default(cuid())
  projectId String
  branchId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channels ChatChannel[]

  @@unique([projectId, branchId, name])
  @@index([projectId, branchId, sortOrder])
}

/**
 * A named copilot conversation thread within a project branch. Every branch
 * gets a default "General" channel; users can add more (e.g. "Enclosure",
 * "Firmware") to keep parallel workstreams separate.
 */
model ChatChannel {
  id         String   @id @default(cuid())
  projectId  String
  branchId   String
  categoryId String?
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category ChatChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@unique([projectId, branchId, name])
  @@index([projectId, branchId, createdAt])
  @@index([categoryId, sortOrder])
}

/**
 * Persisted project chat history for the AI copilot sidebar. Message
 * `parts` stores the AI SDK UIMessage parts array (text + tool calls).
 * channelId is null only for legacy rows, which belong to "General".
 */
model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  branchId  String
  channelId String?
  role      String
  parts     Json
  createdAt DateTime @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([projectId, branchId, createdAt])
  @@index([channelId, createdAt])
}

enum ChatRunStatus {
  PENDING
  RUNNING
  DONE
  ERROR
  CANCELLED
}

/**
 * A copilot turn executed by the background worker. Clients subscribe to the
 * run's event stream (SSE + realtime broadcast) instead of holding an HTTP
 * connection open while the model runs.
 */
model ChatRun {
  id            String        @id @default(cuid())
  projectId     String
  branchId      String
  channelId     String
  actorId       String
  status        ChatRunStatus @default(PENDING)
  error         String?
  inputMessages Json
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  ChatRunEvent[]

  @@index([channelId, status, createdAt])
  @@index([status, createdAt])
}

/** Ordered UI message stream chunks for a run (replay + reconnect). */
model ChatRunEvent {
  id        String   @id @default(cuid())
  runId     String
  seq       Int
  chunk     Json
  createdAt DateTime @default(now())

  run ChatRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
}

// ---------- Stage 3: Verify ----------

enum ValidationCategory {
  VISUAL
  ELECTRICAL
  MECHANICAL
  SOFTWARE
  CROSS_DOMAIN
}

enum ValidationStatus {
  PENDING
  PASS
  FAIL
  WARNING
  SKIPPED
  SIMULATED
  ERROR
}

enum ValidationSeverity {
  INFO
  MINOR
  MAJOR
  CRITICAL
}

model ValidationCheck {
  id           String             @id @default(cuid())
  projectId    String
  branchId     String
  category     ValidationCategory @default(CROSS_DOMAIN)
  title        String
  detail       String?
  status       ValidationStatus   @default(PENDING)
  severity     ValidationSeverity @default(INFO)
  evidence     String?
  waived       Boolean            @default(false)
  waiverReason String?
  approvedById String?
  approvedAt   DateTime?
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, branchId])
}

// ---------- Stage 4: Launch ----------

model Release {
  id          String   @id @default(cuid())
  projectId   String
  branchId    String
  version     String
  notes       String?
  // Immutable frozen copy of requirements, components, repos, and checks
  // at creation time. Releases are never mutated (PRD 14.1).
  snapshot    Json
  createdById String
  createdByName String
  createdAt   DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([projectId, version])
  @@index([projectId, branchId])
}

/// AI-generated storefront / product landing page (PRD 6.1).
///
/// Sites belong to a Workspace (a storefront may sell several products) and
/// MAY link to the project whose product they sell. Generation, preview
/// hosting, and deployment are owned by the site builder behind
/// SiteBuilderPort — FOUNDRY stores only the ids needed to resume editing,
/// and never runs build containers of its own.
model Site {
  id          String     @id @default(cuid())
  workspaceId String
  projectId   String?
  /// Release the page describes. Null while the site is still a draft.
  releaseId   String?
  name        String
  slug        String
  status      SiteStatus @default(DRAFT)
  /// Prompt that produced the current revision.
  prompt      String
  /// Builder conversation id; every revision of this site shares it.
  builderChatId String
  /// Builder version id of the current revision; the deploy target.
  builderVersionId String?
  /// Sandboxed preview URL for the current revision.
  previewUrl  String?
  /// The builder's own editor URL, for an "open in v0" escape hatch.
  builderUrl  String?
  /// Public URL once published.
  publishedUrl String?
  /// True when produced by the SIMULATED adapter. Never publishable.
  simulated   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checkout  CheckoutConfiguration?
  listings  Listing[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, projectId])
}

enum SiteStatus {
  DRAFT
  PUBLISHED
}

/// Shopify connection for a Site. Shopify owns catalog, inventory, payment,
/// tax, and the hosted checkout; FOUNDRY stores only what is needed to
/// resolve a product and mint a cart. `sellerName` is the seller identity
/// PRD 24.4 requires before checkout may be activated.
model CheckoutConfiguration {
  id          String            @id @default(cuid())
  siteId      String            @unique
  provider    CommerceProvider  @default(SHOPIFY)
  /// e.g. `my-store.myshopify.com`.
  shopDomain  String
  /// Storefront access token (public-scope by design). Never returned to
  /// the browser by the API — see the commerce router's select lists.
  storefrontToken String
  /// Legal seller shown at checkout. Required to activate a listing.
  sellerName  String
  currency    String            @default("USD")
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// A product offered on a Site (PRD 21 `Listing`).
///
/// PRD 14.5: a public listing MUST reference an immutable release and MUST
/// NOT read mutable branch data. A listing MAY be drafted before a release
/// exists, but `canActivateListing` refuses to make it ACTIVE until one is
/// selected, so checkout is impossible without it.
model Listing {
  id          String        @id @default(cuid())
  siteId      String
  releaseId   String?
  saleMode    SaleMode      @default(PHYSICAL)
  title       String
  /// Price snapshot in minor units, taken from the store when activated.
  priceCents  Int?
  currency    String?
  /// Product handle in the merchant's store.
  externalHandle String
  /// Variant id resolved from the store; the checkout line item.
  externalVariantId String?
  status      ListingStatus @default(DRAFT)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  release Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@unique([siteId, externalHandle])
  @@index([siteId, status])
}

enum CommerceProvider {
  SHOPIFY
}

enum ListingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// PRD 14.4 sale modes.
enum SaleMode {
  PHYSICAL
  PREORDER
  KIT
  PCB_ONLY
  MECHANICAL_FILES
  DESIGN_BUNDLE
  LICENSE
  TEMPLATE
}
