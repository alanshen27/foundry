# --- Database (Supabase Postgres or local Docker Postgres) ---
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry
# Direct/session connection for Prisma migrations & db push (DDL cannot run over
# a transaction pooler). For Supabase use the port-5432 session pooler URL.
# Optional for local Docker Postgres (falls back to DATABASE_URL).
DIRECT_URL=postgresql://foundry:foundry@localhost:5432/foundry

# --- Auth ---
# "supabase" uses Supabase Auth. "local" is a clearly-labeled LOCAL dev/e2e
# adapter (email+password stored in Postgres); never use "local" in production.
AUTH_MODE=local
# Secret used to sign LOCAL session cookies. Required when AUTH_MODE=local.
AUTH_SECRET=dev-secret-change-me

# --- Supabase (required when AUTH_MODE=supabase, STORAGE_MODE=supabase,
#     or NEXT_PUBLIC_REALTIME_MODE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Object storage ---
# "supabase" uses Supabase Storage. "local" writes to .local-storage/ and is
# labeled SIMULATED; for development only.
STORAGE_MODE=local
STORAGE_BUCKET=artifacts

# --- AI copilot ---
# Set to enable the project AI assistant (chat sidebar + pipeline bootstrap).
# OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# --- Realtime presence ---
# "supabase" enables Supabase Realtime presence channels. "off" disables
# presence (you only see yourself in the collaborator bar).
NEXT_PUBLIC_REALTIME_MODE=off
