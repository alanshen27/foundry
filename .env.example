# --- Database (Supabase Postgres or local Docker Postgres) ---
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry
# Direct/session connection for Prisma migrations & db push (DDL cannot run over
# a transaction pooler). For Supabase use the port-5432 session pooler URL.
# Optional for local Docker Postgres (falls back to DATABASE_URL).
DIRECT_URL=postgresql://foundry:foundry@localhost:5432/foundry

# --- Auth ---
# "supabase" uses Supabase Auth. "local" is a clearly-labeled LOCAL dev/e2e
# adapter (email+password stored in Postgres); never use "local" in production.
AUTH_MODE=local
# Secret used to sign LOCAL session cookies. Required when AUTH_MODE=local.
AUTH_SECRET=dev-secret-change-me

# --- Supabase (required — object storage always uses Supabase Storage;
#     also required when AUTH_MODE=supabase or NEXT_PUBLIC_REALTIME_MODE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Object storage (Supabase Storage only) ---
# Create a private bucket with this name in the Supabase project.
STORAGE_BUCKET=artifacts

# --- AI copilot ---
# Set to enable the project AI assistant (chat sidebar + pipeline bootstrap).
# gpt-5.6 is a reasoning model: temperature/top_p are unsupported (never sent).
AI_MODEL=gpt-5.6
# Origin used by the background copilot worker for render/screenshot tools.
APP_ORIGIN=http://localhost:3000

# --- Realtime presence ---
# "supabase" enables Supabase Realtime presence channels. "off" disables
# presence (you only see yourself in the collaborator bar).
NEXT_PUBLIC_REALTIME_MODE=off

# --- Yjs code collaboration (Hocuspocus) ---
# WebSocket URL for Engineer > Code multiplayer Monaco. When unset, the editor
# falls back to single-player autosave. Start the collab server with
# `pnpm --filter @foundry/collab-server dev` (included in `pnpm dev`).
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
# Optional listen port for apps/realtime (default 1234).
# COLLAB_PORT=1234

# --- Background Jobs (BullMQ) ---
# Redis URL for the background job queue (e.g. AI chat streaming).
REDIS_URL=redis://localhost:6379

# --- Mechanical CAD (Zoo / KittyCAD) ---
# Required for Engineer > Model: live engine viewport + text-to-CAD.
# Create a token at https://zoo.dev/account — $10/mo free API credit.
# Assembly tools also spawn Zoo MCP (`uvx zoo-mcp`) for bbox / execute /
# multiview — install uv (https://docs.astral.sh/uv/) so `uvx` is on PATH.
ZOO_API_TOKEN=

# --- Storefront sites (v0 Platform API) ---
# Required for Sites: v0 generates the landing page, hosts the preview, and
# deploys it to Vercel. Create a key at https://v0.dev/chat/settings/keys
# Unset falls back to a SIMULATED builder that generates nothing and refuses
# to publish — dev/e2e only.
V0_API_KEY=

# --- Workspace home ---
# Optional. When set, signed-in users who are members of this slug land on
# /w/{slug} instead of the oldest membership. Seed uses demo-workspace.
# FOUNDRY_DEFAULT_WORKSPACE_SLUG=demo-workspace
